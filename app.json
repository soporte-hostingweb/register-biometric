{
  "expo": {
    "name": "HWPerú - Asistencia",
    "slug": "jose-benites",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hwperu-official-icon.png",
    "scheme": "asistenciaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hwperu.asistencia",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/hwperu-official-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/hwperu-favicon-v3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/hwperu-official-logo.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite el acceso a tu ubicación para registrar dónde marcaste tu asistencia."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63269527-9ff3-4486-ac75-7a60fabce539"
      }
    },
    "owner": "josebenitess-team"
  }
}
